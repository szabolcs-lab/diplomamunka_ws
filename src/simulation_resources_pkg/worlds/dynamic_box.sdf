<?xml version="1.0"?>
<sdf version="1.8">
  <model name="dynamic_box">
    <static>true</static>

    <link name="link">
      <pose>0 0 0.5 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 2.5 1.0</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 2.5 1.0</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
